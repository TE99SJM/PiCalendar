# Local-only: this is secure from other devices on your network by default.
FAMILY_CALENDAR_HOST=127.0.0.1
FAMILY_CALENDAR_PORT=8080

# Do NOT set HOST=0.0.0.0 without adding authentication first.
FAMILY_CALENDAR_TIMEZONE=America/Chicago

# Optional true backlight control for compatible panels. Only set after
# verifying that touch continues working while the backlight is off.
# FAMILY_CALENDAR_BACKLIGHT_DEVICE=your_backlight_device_name

# Optional HDMI monitor standby through DDC/CI. Install ddcutil, enable DDC/CI
# in the monitor's menu, and test that its USB touchscreen remains usable in
# standby before enabling this. Choose the monitor number reported by ddcutil
# detect (usually 1 when only one monitor is connected).
# FAMILY_CALENDAR_DDCUTIL_DISPLAY=1

# Event history kept offline. Full history refreshed weekly while online.
FAMILY_CALENDAR_HISTORY_DAYS=730
FAMILY_CALENDAR_FUTURE_DAYS=730

# Publisher-only setup: end users will NOT enter credentials or upload JSON.
# Set these variables in your device image/service, or place the developer's
# Desktop OAuth client JSON at config/google-oauth-desktop.json (gitignored).
# FAMILY_CALENDAR_GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
# FAMILY_CALENDAR_GOOGLE_CLIENT_SECRET=developer-provisioned-desktop-client-secret
# FAMILY_CALENDAR_GOOGLE_CLIENT_FILE=/private/path/to/google-client.json
