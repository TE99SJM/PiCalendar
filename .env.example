# Local-only: this is secure from other devices on your network by default.
FAMILY_CALENDAR_HOST=127.0.0.1
FAMILY_CALENDAR_PORT=8080

# Do NOT set HOST=0.0.0.0 without adding authentication first.
FAMILY_CALENDAR_TIMEZONE=America/Chicago

# Optional real backlight power-off when your screen supports it and touch
# remains usable with the backlight at zero. Set only after testing the screen.
# Look for a device in /sys/class/backlight and confirm your Pi user can write
# to its brightness file. Leave commented for HDMI monitors / unknown models.
# FAMILY_CALENDAR_BACKLIGHT_DEVICE=your_backlight_device_name

# Event history kept offline. Full history refreshed weekly while online.
FAMILY_CALENDAR_HISTORY_DAYS=730
FAMILY_CALENDAR_FUTURE_DAYS=730
